{
  "name": "germillion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "data": "node scripts/build-data.mjs && node scripts/build-curated.mjs && node scripts/build-rotation.mjs",
    "feedback": "node scripts/review-feedback.mjs",
    "dev:cloudflare": "wrangler dev --local",
    "check:cloudflare": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke-host.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.142.0"
  }
}
