{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "germillion",
  "main": "worker.mjs",
  "account_id": "6c4a6ff4edd01acb3671de9a1b44de0a",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "germillion",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    {"name":"API_LIMIT","namespace_id":"928001","simple":{"limit":240,"period":60}},
    {"name":"RECOVERY_LIMIT","namespace_id":"928002","simple":{"limit":10,"period":60}}
  ],
  "observability": {"enabled": true,"head_sampling_rate":0.1}
}
